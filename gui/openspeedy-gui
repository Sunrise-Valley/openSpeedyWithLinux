        quit_item = Gtk.MenuItem(label="退出")
        quit_item.connect("activate", lambda w: (self.hide(), Gtk.main_quit()))
        menu.append(quit_item)
        menu.show_all()
        menu.popup(None, None, None, None, button, time)

