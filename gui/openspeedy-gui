# ── Shared memory protocol (must match include/openspeedy.h) ──────
SHM_NAME = "/openspeedy_shm"
SHM_SIZE = 4096

class SpeedState(ctypes.Structure):
    _fields_ = [
        ("multiplier", ctypes.c_double),
        ("enabled", ctypes.c_int),
        ("cmd_seq", ctypes.c_uint64),
        ("version", ctypes.c_uint32),
        ("controller_pid", ctypes.c_int),
    ]

def read_speed_state():
    """Read speed state from shared memory. Returns SpeedState or None."""
    try:
        fd = os.open(f"/dev/shm{SHM_NAME}", os.O_RDONLY)
        data = os.read(fd, ctypes.sizeof(SpeedState))
        os.close(fd)
        return SpeedState.from_buffer_copy(data)
    except (OSError, FileNotFoundError):
        return None

def write_speed_state(state):
    """Write speed state to shared memory. Returns True on success."""
    try:
        fd = os.open(f"/dev/shm{SHM_NAME}", os.O_RDWR | os.O_CREAT, 0o666)
        os.ftruncate(fd, SHM_SIZE)
        os.pwrite(fd, bytes(state), 0)
        os.close(fd)
        return True
    except OSError:
        return False

def set_speed(multiplier):
    """Set the speed multiplier via shared memory."""
    existing = read_speed_state()
    if existing is None:
        state = SpeedState()
        state.version = 1
        state.multiplier = 1.0
        state.enabled = 0
        state.cmd_seq = 0
        state.controller_pid = os.getpid()
    else:
        state = existing

    state.multiplier = multiplier
    state.enabled = 1 if multiplier != 1.0 else 0
    state.cmd_seq += 1
    state.controller_pid = os.getpid()
    return write_speed_state(state)

def disable_speed():
    """Disable speed modifier but keep multiplier."""
    existing = read_speed_state()
    if existing is None:
        return False
    existing.enabled = 0
    existing.cmd_seq += 1
    return write_speed_state(existing)

def get_system_info():
    """Get CPU and memory usage from /proc."""
    info = {"cpu": 0.0, "mem_used": 0.0, "mem_total": 0.0, "os": ""}

    # OS version
    try:
        with open("/etc/os-release") as f:
            for line in f:
                if line.startswith("PRETTY_NAME="):
                    info["os"] = line.split("=", 1)[1].strip().strip('"')
                    break
    except Exception:
        info["os"] = "Linux"

    # Memory (simple read from /proc/meminfo)
    try:
        mem_total = 0
        mem_available = 0
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_total = int(line.split()[1])
                elif line.startswith("MemAvailable:"):
                    mem_available = int(line.split()[1])
                    break
        info["mem_total"] = mem_total / 1024 / 1024  # Convert to GB
        info["mem_used"] = (mem_total - mem_available) / 1024 / 1024
    except Exception:
        pass

    # CPU (simple sampling)
    try:
        with open("/proc/stat") as f:
            fields = f.readline().split()
        total = sum(int(x) for x in fields[1:])
        idle = int(fields[4])
        # Return idle% for now; caller computes usage
        info["_cpu_idle"] = idle
        info["_cpu_total"] = total
    except Exception:
        pass

    return info


# ── Process List ──────────────────────────────────────────────────
def get_processes():
    """Get list of running processes with PIDs and names."""
    procs = []
    try:
        for entry in os.listdir("/proc"):
            if not entry.isdigit():
                continue
            try:
                pid = int(entry)
                with open(f"/proc/{pid}/comm") as f:
                    name = f.read().strip()
                procs.append((pid, name))
            except (OSError, PermissionError):
                continue
    except Exception:
        pass
    return sorted(procs, key=lambda x: x[1].lower())


