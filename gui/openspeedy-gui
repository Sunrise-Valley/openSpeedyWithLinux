    # ── Slider logic ──────────────────────────────────────────
    def slider_to_factor(self, value):
        """Convert slider position to speed multiplier."""
        if value <= 0:
            return max(0.01, 1.0 + value / 50.0)  # 0→1x, -50→0.01x
        elif value <= 40:
            return 1.0 + value / 100.0 * 0.5       # 0→1x, 40→1.2x
        elif value <= 100:
            return 1.2 + (value - 40) / 60.0 * 0.8  # 40→1.2x, 100→2x
        elif value <= 200:
            return 2.0 + (value - 100) / 100.0 * 3.0  # 100→2x, 200→5x
        elif value <= 300:
            return 5.0 + (value - 200) / 100.0 * 5.0  # 200→5x, 300→10x
        else:
            return 10.0 + (value - 300) / 100.0 * 40.0  # 300→10x, 400→50x

    def factor_to_slider(self, factor):
        """Convert speed multiplier to slider position."""
        if factor <= 1.0:
            return int((factor - 1.0) * 50.0)  # 0.01x→-50, 1x→0
        elif factor <= 1.2:
            return int((factor - 1.0) / 0.5 * 40.0)  # 1x→0, 1.2x→40
        elif factor <= 2.0:
            return int(40 + (factor - 1.2) / 0.8 * 60.0)  # 1.2x→40, 2x→100
        elif factor <= 5.0:
            return int(100 + (factor - 2.0) / 3.0 * 100.0)  # 2x→100, 5x→200
        elif factor <= 10.0:
            return int(200 + (factor - 5.0) / 5.0 * 100.0)  # 5x→200, 10x→300
        else:
            return int(300 + (factor - 10.0) / 40.0 * 100.0)  # 10x→300, 50x→400

    def _on_slider_changed(self, slider):
        factor = self.slider_to_factor(slider.get_value())
        self.spinbox.set_value(factor)
        self.speed_label.set_text(f"✖️{factor:.2f}倍")
        # Apply immediately only if dragging ends; value-changed fires during drag too

    def _on_slider_released(self, slider, event):
        factor = self.slider_to_factor(slider.get_value())
        self._apply_speed(factor)

    def _on_spinbox_changed(self, spin):
        factor = spin.get_value()
        slider_val = self.factor_to_slider(factor)
        self.slider.set_value(slider_val)
        self.speed_label.set_text(f"✖️{factor:.2f}倍")

    def _on_spinbox_activate(self, spin):
        self._apply_speed(spin.get_value())

    def _on_apply_clicked(self, btn):
        self._apply_speed(self.spinbox.get_value())

    def _apply_speed(self, factor):
        if factor == 1.0:
            disable_speed()
            self.statusbar.push(0, "速度已重置为 1.00x")
        else:
            set_speed(factor)
            self.statusbar.push(0, f"速度已设置为 {factor:.2f}x")

    def _on_reset(self, btn):
        """Reset speed to 1.0x."""
        disable_speed()
        self.slider.set_value(0)
        self.spinbox.set_value(1.0)
        self.speed_label.set_text("✖️1.00倍")
        self.statusbar.push(0, "速度已重置为 1.00x")

    # ── Process list ──────────────────────────────────────────
    def _refresh_process_list(self, *args):
        """Refresh process list from /proc."""
        filter_text = self.filter_entry.get_text().lower() if hasattr(self, 'filter_entry') else ""

        self.proc_store.clear()
        for pid, name in get_processes():
            if not filter_text or filter_text in name.lower():
                self.proc_store.append([pid, name])

    def _on_filter_changed(self, entry):
        self._refresh_process_list()

    def _on_process_activated(self, view, path, column):
        """Double-click a process to launch it with speed mod."""
        model = view.get_model()
        pid = model[path][0]
        name = model[path][1]
        # Apply current speed first
        current_factor = self.spinbox.get_value()
        if current_factor != 1.0:
            set_speed(current_factor)

        # Notify user — they need to start the game with LD_PRELOAD
        dialog = Gtk.MessageDialog(
            parent=self,
            flags=Gtk.DialogFlags.MODAL,
            type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK,
            message_format=f"要对 {name} (PID: {pid}) 应用变速吗？"
        )
        dialog.format_secondary_text(
            "OpenSpeedy 通过 LD_PRELOAD 机制工作。\n"
            "请在启动游戏时设置环境变量：\n\n"
            "  LD_PRELOAD=./build/libopenspeedy.so ./your_game\n\n"
            "或在终端运行:\n"
            "  speedctl run ./your_game"
        )
        dialog.run()
        dialog.destroy()

    # ── Auto-start ────────────────────────────────────────────
    def _check_autostart(self):
        """Check if autostart .desktop file exists."""
        autostart_path = os.path.expanduser(
            "~/.config/autostart/openspeedy.desktop")
        return os.path.exists(autostart_path)

    def _on_autostart_toggle(self, cb):
        """Enable/disable autostart via .desktop file."""
        autostart_dir = os.path.expanduser("~/.config/autostart")
        autostart_path = os.path.join(autostart_dir, "openspeedy.desktop")

        if cb.get_active():
            os.makedirs(autostart_dir, exist_ok=True)
            desktop_entry = f"""[Desktop Entry]
Type=Application
Name=OpenSpeedy
Comment=Game Speed Modifier
Exec={sys.argv[0]}
Icon=applications-games
Terminal=false
Categories=Game;Utility;
X-GNOME-Autostart-enabled=true
"""
            with open(autostart_path, "w") as f:
                f.write(desktop_entry)
            self.statusbar.push(0, "已启用开机自启")
        else:
            try:
                os.remove(autostart_path)
                self.statusbar.push(0, "已禁用开机自启")
            except FileNotFoundError:
                pass

