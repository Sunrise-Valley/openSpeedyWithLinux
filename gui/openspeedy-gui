    # ── Periodic refresh ──────────────────────────────────────
    def _start_refresh_timer(self):
        """Start timer to refresh system info every 2 seconds."""
        GLib.timeout_add(2000, self._refresh_sysinfo)

    def _refresh_sysinfo(self):
        """Update system info display."""
        try:
            info = get_system_info()

            # OS
            if info["os"]:
                self.os_value.set_text(info["os"])

            # CPU usage
            if info.get("_cpu_idle"):
                idle = info["_cpu_idle"]
                total = info["_cpu_total"]
                if self._prev_cpu:
                    prev_idle, prev_total = self._prev_cpu
                    idle_diff = idle - prev_idle
                    total_diff = total - prev_total
                    if total_diff > 0:
                        usage = (1.0 - idle_diff / total_diff) * 100
                        self.cpu_value.set_text(f"{usage:5.1f}%")
                self._prev_cpu = (idle, total)

            # Memory
            if info["mem_total"] > 0:
                self.mem_value.set_text(
                    f"({info['mem_used']:.1f}G / {info['mem_total']:.1f}G) "
                    f"{info['mem_used']/info['mem_total']*100:.1f}%"
                )

            # Check LD_PRELOAD status
            state = read_speed_state()
            if state and state.enabled:
                self.ld_value.set_text(f"激活 ({state.multiplier:.2f}x)")
                self.ld_value.get_style_context().remove_class("status-ok")
                self.ld_value.get_style_context().add_class("status-err")
            else:
                self.ld_value.set_text("正常")
                self.ld_value.get_style_context().remove_class("status-err")
                self.ld_value.get_style_context().add_class("status-ok")
        except Exception:
            pass
        return True  # Keep timer running


# ── Entry point ───────────────────────────────────────────────────
def main():
    window = OpenSpeedyWindow()
    window.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
